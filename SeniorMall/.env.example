# =============================================================
# SeniorMall - Environment variables (example)
# Copy this file to `.env` and fill real values. Never commit `.env`.
# =============================================================

# Prisma / PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/seniormall?schema=public"

# JWT secrets (use `openssl rand -hex 32` in real environments)
JWT_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"

# Express
PORT=3001

# CORS allow-origin (Vite dev server)
CLIENT_URL="http://localhost:5173"
